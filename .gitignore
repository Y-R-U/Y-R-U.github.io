# Per-run gen logs (transient, regenerated on each bulk_generate run)
gms/2d/the_horrors/*.log
gms/2d/awake/*.log
# PolyPerfect "Low Poly Ultimate Pack" — a commercial Unity Asset Store pack.
# The gallery PAGE is committed, but the art ships only as an obfuscated pack
# (app/3d/gallery/assets/pack.dat, built by tools/build_pack.py). The raw
# GLB/PNG source folders stay LOCAL — never committed — and double as the
# reference cache for current/future games.
app/3d/gallery/models_all/
app/3d/gallery/models/
# Western shooter — still loads the raw local-only assets directly.
gms/3d/western/
gms/2d/scare_batch.log

# Transient regen-helper run log
regen_helper.out
__pycache__/

# Driven UI-test scratch copies (DEV_CONTRACT §11: a UI test never touches the live tree).
# They have to live here rather than in /tmp because the games import three from ../../lib/three,
# which is outside a game's own directory. Each test deletes its own on the way out; this is the
# guard for a run that was interrupted before it could.
gms/3d/.wf-*test/
