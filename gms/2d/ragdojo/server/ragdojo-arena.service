[Unit]
Description=ragdojo-arena — RAGDOJO online lobby, signalling, relay and stats (games.br8t.com/gms/2d/ragdojo/arena/)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/apps/ragdojo-arena
ExecStart=/srv/apps/ragdojo-arena/ragdojo-arena
Restart=on-failure
RestartSec=2
Environment=ARENA_ADDR=127.0.0.1:8017
Environment=ARENA_PREFIX=/gms/2d/ragdojo/arena
Environment=ARENA_DB=/srv/data/ragdojo-arena/arena.db
Environment=ARENA_ICE_URL=http://127.0.0.1:8014/ice
Environment=ARENA_ALLOWANCE_URL=http://127.0.0.1:8016/api/br8t/allowance
Environment=GOMEMLIMIT=48MiB
# Never set ARENA_DEV_AUTH, ARENA_OPEN_LOBBY or ARENA_LAN here.
MemoryMax=128M
CPUQuota=50%
UMask=0077
TimeoutStopSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/data/ragdojo-arena

[Install]
WantedBy=multi-user.target
