[Unit]
Description=clued — CLUED live rooms + challenge links (games.br8t.com/gms/2d/clued/)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/apps/clued
ExecStart=/srv/apps/clued/clued
Restart=on-failure
RestartSec=3
Environment=CLUED_ADDR=127.0.0.1:8012
Environment=CLUED_DATA=/srv/data/clued
Environment=CLUED_PREFIX=/gms/2d/clued
Environment=GOMEMLIMIT=48MiB
MemoryMax=128M
# Secrets (CLUED_NTFY_TOPIC, optional CLUED_SMTP_*) live only on the box; "-" = optional.
EnvironmentFile=-/srv/data/clued/clued.env
UMask=0077
TimeoutStopSec=8

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/data/clued

[Install]
WantedBy=multi-user.target
