  "voice_name": "Heirframe · Mara Quill",
  "file": "b_mara_twist_02.mp3",
  "duration": 2.76,
  "seed": 42,
  "job_id": "856099b9eb904ca8a95f374fecf28f72",
  "sig": "26d77dc1af39",
  "qc": []
 },
 "b_mara_ambush_01": {
