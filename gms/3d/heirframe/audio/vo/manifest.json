  "job_id": "0a0f0d04e26243f38027614d2ecb5da3",
  "sig": "4b4859e4f5e6",
  "qc": []
 },
 "pa_calm_01": {
  "text": "Disturbance reported. Wardens are responding. Please remain calm and beautiful.",
