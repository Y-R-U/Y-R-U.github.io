  "voice_name": "Heirframe · Mara Quill",
  "file": "b_mara_fail_01.mp3",
  "duration": 2.58,
  "seed": 42,
  "job_id": "6236b5694d7b403682aa758765d65d16",
  "sig": "ecd55734ed47",
  "qc": []
 },
 "b_mara_fail_02": {
  "text": "Client's not happy. Neither am I. Next one.",
