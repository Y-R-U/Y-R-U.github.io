 "a1_s00_hira_01": {
  "text": "Good morning, valued rider! Welcome to HireFrame. Your R-1 is ready for another brighter day!",
  "voice": "hira",
  "voice_name": "Heirframe · HIRA",
  "file": "a1_s00_hira_01.mp3",
  "duration": 6.13,
  "seed": 42,
  "job_id": "4f68ec5bf68a48a895e5f12d2244e1ae",
  "sig": "648a9c0b4b76",
  "qc": []
 },
 "a1_s00_hira_02": {
  "text": "Link stable. Latency: zero milliseconds! Wow, that's... unusually good. Anyway!",
  "voice": "hira",
  "voice_name": "Heirframe · HIRA",
  "file": "a1_s00_hira_02.mp3",
  "duration": 7.16,
  "seed": 42,
  "job_id": "8ae39a9d94fb4aaea8ba8624c1c3e721",
  "sig": "7704bbf20c7d",
  "qc": []
 },
 "a1_s00_harmony_01": {
  "text": "Good morning, Halcyon. Renewal Day is one hundred days away. Two hundred and twenty-five years of unity. The journey continues.",
  "voice": "harmony",
  "voice_name": "Heirframe · Iris Vael",
  "file": "a1_s00_harmony_01.mp3",
  "duration": 9.47,
  "seed": 42,
  "job_id": "079966434bdd43049e7ed60f53e65abb",
  "sig": "43cefbf2b5bd",
  "qc": []
 },
 "a1_s00_mara_01": {
  "text": "Wren? It's Mara. Quill Contracts, the kiosk by the fountain. You said you wanted work.",
  "voice": "mara",
  "voice_name": "Heirframe · Mara Quill",
  "file": "a1_s00_mara_01.mp3",
  "duration": 6.14,
  "seed": 42,
  "job_id": "957716d04b0b4866a63734954b7eb21a",
  "sig": "cf6ab0df91e9",
  "qc": []
 },
 "a1_s00_mara_02": {
  "text": "I've got a parcel that needs legs. Yours are rented, but they'll do.",
  "voice": "mara",
  "voice_name": "Heirframe · Mara Quill",
  "file": "a1_s00_mara_02.mp3",
  "duration": 3.43,
  "seed": 42,
  "job_id": "253cff8df3db45e58a7cc9ef53d66ac7",
  "sig": "435faa31efde",
  "qc": []
 },
 "a1_s00_hira_03": {
  "text": "Tip! Drag the left side of the screen to walk. Tap anywhere to go there. Walking is included in your plan!",
  "voice": "hira",
  "voice_name": "Heirframe · HIRA",
  "file": "a1_s00_hira_03.mp3",
  "duration": 7.23,
  "seed": 42,
  "job_id": "d0b1080bceef436d9a0017957444612d",
  "sig": "6c383989a7ab",
  "qc": []
 },
 "a1_s01_mara_01": {
  "text": "Locker seven, north side. Grab the parcel, walk it to drop-locker twelve. Don't open it, don't drop it, don't sell it.",
  "voice": "mara",
  "voice_name": "Heirframe · Mara Quill",
  "file": "a1_s01_mara_01.mp3",
  "duration": 7.56,
  "seed": 42,
  "job_id": "847b3496e8c54d4a9c6b51768b80c676",
  "sig": "b4f214cc12ba",
  "qc": []
 },
 "a1_s01_hira_01": {
  "text": "Parcel acquired! Did you know HireFrame Premium riders get a complimentary shoulder bag?",
  "voice": "hira",
  "voice_name": "Heirframe · HIRA",
  "file": "a1_s01_hira_01.mp3",
  "duration": 4.82,
  "seed": 42,
  "job_id": "b3f590d085d54165a793ea346daf6833",
  "sig": "9a5a87f5ac6a",
  "qc": []
 },
 "a1_s02_hira_01": {
  "text": "Uh-oh! Scrap rats! Tap attack to swing your baton. Please do not get them on the upholstery.",
  "voice": "hira",
  "voice_name": "Heirframe · HIRA",
  "file": "a1_s02_hira_01.mp3",
  "duration": 6.54,
  "seed": 42,
  "job_id": "64d2f5ced9684ed58006f84966102823",
  "sig": "53c9bb776990",
  "qc": []
 },
 "a1_s02_mara_01": {
  "text": "Rats out of the drains in broad daylight. Brighter future, my foot. Keep moving.",
  "voice": "mara",
  "voice_name": "Heirframe · Mara Quill",
  "file": "a1_s02_mara_01.mp3",
  "duration": 5.41,
  "seed": 42,
  "job_id": "32877e45219048e5b8956cf0c01e1924",
  "sig": "fa6e5e60d580",
  "qc": []
 },
 "a1_s03_hira_01": {
  "text": "Drop-locker twelve! Scanning recipient... recipient is... you? Recipient: Ward four-four-seven-one.",
