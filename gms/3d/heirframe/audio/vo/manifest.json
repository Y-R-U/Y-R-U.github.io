  "text": "Happy birthday, little star. Don't let them see this.",
  "voice": "iris_rec",
  "voice_name": "Heirframe · Iris Vael",
  "file": "a1_s03_iris_01.mp3",
  "duration": 2.84,
  "seed": 42,
  "job_id": "865d6239b9c54819939004d6b999a3a8",
  "sig": "90c1f47fb978",
  "qc": []
 },
 "a1_s03_hira_02": {
  "text": "Mm-mm, mm-mm... Oh! Sorry! Firmware hiccup! I don't know that song.",
  "voice": "hira",
  "voice_name": "Heirframe · HIRA",
  "file": "a1_s03_hira_02.mp3",
  "duration": 4.78,
  "seed": 42,
  "job_id": "d682c1d9d1b24077a63e5ff7e73abfea",
  "sig": "a92f445d5b96",
  "qc": []
 },
 "a1_s04_mara_01": {
  "text": "That's not on my manifest. Who sends a Ward a birthday present?",
  "voice": "mara",
  "voice_name": "Heirframe · Mara Quill",
  "file": "a1_s04_mara_01.mp3",
  "duration": 3.75,
  "seed": 42,
  "job_id": "e25e959938ac468783fbc15f00889624",
  "sig": "314f6f66b7fa",
  "qc": []
 },
 "a1_s04_mara_02": {
  "text": "Keep it in your pocket, kid. Go take some jobs; you've got rent. The board's yours.",
  "voice": "mara",
  "voice_name": "Heirframe · Mara Quill",
  "file": "a1_s04_mara_02.mp3",
  "duration": 4.84,
  "seed": 42,
  "job_id": "c4440c6c13884fb8be2f57c9e1bc1f5e",
  "sig": "b766e6cbeb53",
  "qc": []
 },
 "a1_s05_mara_01": {
  "text": "If you must know what's on that key, there's a pawn-droid called Tinsel in the east arcade. Two hundred cred and he'll look.",
  "voice": "mara",
  "voice_name": "Heirframe · Mara Quill",
  "file": "a1_s05_mara_01.mp3",
  "duration": 7.13,
  "seed": 42,
  "job_id": "383ba39e524c4153acd760044a290f95",
  "sig": "601f1822fc24",
  "qc": []
 },
