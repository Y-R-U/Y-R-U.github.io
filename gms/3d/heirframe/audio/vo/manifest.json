  "duration": 2.63,
  "seed": 42,
  "job_id": "f1cce904e01e46578f56082f7e8c88c4",
  "sig": "70986a1c5328",
  "qc": []
 },
 "b_mara_success_02": {
  "text": "Clean work. I'll tell the client you're a professional. I'll lie.",
