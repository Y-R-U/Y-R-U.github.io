  "voice_name": "Heirframe · Mara Quill",
  "file": "b_mara_fail_02.mp3",
  "duration": 3.35,
  "seed": 42,
  "job_id": "f0c2f4f33f8c48e78ac7cdaed8f131e6",
  "sig": "93eb74adea9d",
  "qc": []
 },
 "b_mara_twist_01": {
  "text": "Hang on. That's not what I was told.",
