  "text": "Tinsel's Pre-Loved Electronics! Two point three stars!",
  "voice": "hira",
  "voice_name": "Heirframe · HIRA",
  "file": "a1_s05_hira_01.mp3",
  "duration": 3.7,
  "seed": 42,
