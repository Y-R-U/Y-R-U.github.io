  "duration": 2.14,
  "seed": 42,
  "job_id": "2bb16f30871b4a598bcfc5516bdf1eec",
  "sig": "95aa039e62db",
  "qc": []
 },
 "b_mara_twist_02": {
  "text": "The client lied. Of course the client lied.",
