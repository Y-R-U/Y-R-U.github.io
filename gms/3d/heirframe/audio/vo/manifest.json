  "voice_name": "Heirframe · Mara Quill",
  "file": "b_mara_success_02.mp3",
  "duration": 4.09,
  "seed": 42,
  "job_id": "f472c11a8f80452bbbe46addb3665d45",
  "sig": "c8ab077dbcf7",
  "qc": []
 },
 "b_mara_success_03": {
  "text": "That's the job. Come back for another.",
  "voice": "mara",
  "voice_name": "Heirframe · Mara Quill",
  "file": "b_mara_success_03.mp3",
  "duration": 2.02,
  "seed": 42,
  "job_id": "20fc753cafe54ee6aaa79c17e9a657ba",
  "sig": "4eb661562fc3",
  "qc": []
 },
 "b_mara_fail_01": {
  "text": "Well, that's gone sideways. Shake it off.",
