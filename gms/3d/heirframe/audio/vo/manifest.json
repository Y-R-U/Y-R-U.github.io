  "voice_name": "Heirframe · Mara Quill",
  "file": "b_mara_accept_02.mp3",
  "duration": 2.66,
  "seed": 42,
  "job_id": "6d3a89cd76a742dd8755e465a15470ea",
  "sig": "934d72b2e94a",
  "qc": []
 },
 "b_mara_accept_03": {
