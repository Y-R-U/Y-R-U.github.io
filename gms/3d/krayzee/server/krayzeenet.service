[Unit]
Description=krayzeenet — Kingdom of Krayzee online rooms (games.br8t.com/gms/3d/krayzee/)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/apps/krayzeenet
ExecStart=/srv/apps/krayzeenet/krayzeenet
Restart=on-failure
RestartSec=3
Environment=KRAYZEE_ADDR=127.0.0.1:8018
Environment=KRAYZEE_PREFIX=/gms/3d/krayzee/net
Environment=KRAYZEE_ICE_URL=http://127.0.0.1:8014/ice
Environment=GOMEMLIMIT=40MiB
MemoryMax=64M
EnvironmentFile=-/srv/data/krayzeenet/krayzeenet.env
UMask=0077
TimeoutStopSec=8

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
