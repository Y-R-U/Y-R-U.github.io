# shots/*.json are the COMMITTED scenario definitions (§2.1); renders and stats are not.
shots/*.png
shots/*.jpg
shots/*.stats.json
shots/_*.json
# Every per-phase evidence directory (p1a … p11, wire, …). This was a list of four subdirs
# until P10, by which point p4/p5/p6/p7a/p7b/p8/p11/wire had appeared under it — 25 MB of
# renders that the line above says are not committed. A glob cannot fall behind that way.
shots/*/
critique/
__pycache__/
*.log
.DS_Store

# SUNO source takes — the full multi-line generations. Kept locally so a group can be
# re-split without regenerating; never shipped (~40 MB and redundant with the cut clips).
tools/vo/raw/
tools/vo/vw/

# §S2-S audition intermediates — 23 MB of per-voice Kokoro takes and their treated copies, and the
# 1.6 MB of mp3 the audition page is assembled FROM them. Same rule as raw/ above: the takes that
# ship are committed, the material they were chosen out of is not. build.py rebuilds clips/ from
# vcmp/, and voice_probe.py + pitch_probe.py rebuild vcmp/. The ratings themselves (votes.json) ARE
# committed — they are the evidence the cast note in gen_story.py cites.
tools/vo/vcmp/
tools/vo/audition/clips/
