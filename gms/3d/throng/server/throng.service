[Unit]
Description=throng — THRONG online rooms, snapshot relay and leaderboards (games.br8t.com/gms/3d/throng/)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/apps/throng
ExecStart=/srv/apps/throng/throng
Restart=on-failure
RestartSec=3
Environment=THRONG_ADDR=127.0.0.1:8024
Environment=THRONG_DATA=/srv/data/throng
Environment=THRONG_PREFIX=/gms/3d/throng
Environment=GOMEMLIMIT=40MiB
MemoryMax=96M
EnvironmentFile=-/srv/data/throng/throng.env
UMask=0077
TimeoutStopSec=8

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/data/throng

[Install]
WantedBy=multi-user.target
