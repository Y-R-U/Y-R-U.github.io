    "society.greeter.contracts": {
      "name": "Vail — what is a contract",
      "cam": "two",
      "lines": [
        {
          "who": "greeter",
          "text": "Somebody wants something fought. You take the board's word for it and go and fight it.",
          "vo": "greeter_contracts_01"
        },
        {
          "who": "greeter",
          "text": "Iron pays little and forgives much. Gold does neither.",
          "vo": "greeter_contracts_02"
        }
      ],
      "choices": [
        {
          "say": "What is upstairs?",
          "goto": "society.greeter.floors",
          "sets": []
        },
        {
          "say": "And the fourth board?",
          "goto": "society.greeter.newadventures",
          "sets": []
        },
        {
          "say": "Iron it is.",
          "goto": "society.greeter.done",
          "sets": [
            {
              "k": "flag",
              "name": "society.chose.iron",
              "value": true
            }
          ]
        }
      ],
      "next": null,
      "sets": [
        {
          "k": "flag",
          "name": "society.knows.contracts",
          "value": true
        }
      ]
    },
    "society.greeter.floors": {
      "name": "Vail — the floors",
      "cam": "two",
      "lines": [
        {
          "who": "greeter",
          "text": "Five floors. This one is registration, and it is open to anybody who can find the door."
        },
        {
          "who": "greeter",
          "text": "Iron above us, then bronze, then silver, then gold. The stair knows what you are. Bel stands at the foot of it in case the stair is not persuasive enough."
        },
        {
          "who": "greeter",
          "text": "The higher you go the emptier the boards get. There are three gold contracts in the province and two of them have been up for a year."
        }
      ],
      "choices": [
        {
          "say": "How do I get to iron?",
          "goto": "society.greeter.test",
          "sets": []
        },
        {
          "say": "Understood.",
          "goto": "society.greeter.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": [
        {
          "k": "flag",
          "name": "society.knows.floors",
          "value": true
        }
      ]
    },
    "society.greeter.test": {
      "name": "Vail — the proving",
      "cam": "two",
      "lines": [
        {
          "who": "greeter",
          "text": "You join by proving you will still be alive at the end of your first contract. We stopped taking people's word for it."
        },
        {
          "who": "greeter",
          "text": "One room, one monster, one knife. Brann has the knife. The monster is an earth elemental and it is a weak one, which is not the same as an easy one."
        },
        {
          "who": "greeter",
          "text": "It mends itself off bare earth. The floor of that room is half stone and half dirt, and that is the whole of the lesson."
        }
      ],
      "choices": [
        {
          "say": "I'm ready.",
          "goto": "society.greeter.proving.go",
          "sets": []
        },
        {
          "say": "What happens if I lose?",
          "goto": "society.greeter.proving.lose",
          "sets": []
        },
        {
          "say": "Not yet.",
          "goto": "society.greeter.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": [
        {
          "k": "flag",
          "name": "society.test.offered",
          "value": true
        }
      ]
    },
    "society.greeter.proving.lose": {
      "name": "Vail — if you lose",
      "cam": "two",
      "lines": [
        {
          "who": "greeter",
          "text": "You come back here with a headache and a bill from the healer. Then you go again."
        },
        {
          "who": "greeter",
          "text": "Nobody has died in the proving room in eleven years. That is not luck, that is the room. It is also four people standing behind a grille you cannot see, being paid to be bored."
        }
      ],
      "choices": [
        {
          "say": "Then let's go.",
          "goto": "society.greeter.proving.go",
          "sets": []
        },
        {
          "say": "Later.",
          "goto": "society.greeter.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": []
    },
    "society.greeter.proving.go": {
      "name": "Vail — into the proving room",
      "cam": "close",
      "lines": [
        {
          "who": "greeter",
          "text": "Down the passage, then. Keep it off the dirt, or keep it too busy to reach any."
