    "society.greeter.essences": {
      "name": "Vail — four essences",
      "cam": "two",
      "lines": [
        {
          "who": "greeter",
          "text": "You are standing there dripping, so I take it the elemental is gravel. Good. Sit down before you fall down."
        },
        {
          "who": "greeter",
          "text": "Now the part that decides what you become. Three essences. Whatever those three come to between them is the fourth, and nobody chooses that one — it chooses itself."
        }
      ],
      "choices": [
