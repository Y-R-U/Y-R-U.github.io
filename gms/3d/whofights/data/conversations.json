    "society.clerk.gold": {
      "name": "Ashenrow — gold floor",
      "cam": "two",
      "lines": [
        {
          "who": "clerk_gold",
          "text": "Gold. Three. It is usually two."
        },
        {
          "who": "clerk_gold",
          "text": "I am obliged to say this part out loud, so: taking one of these is not accepting a contract. It is a decision about the rest of your life. There. Said."
        }
      ],
      "choices": [
        {
          "say": "Why three?",
          "goto": "society.clerk.gold.three",
          "sets": []
        },
        {
          "say": "Do you have to say that to everyone?",
          "goto": "society.clerk.gold.obliged",
          "sets": []
        },
        {
          "say": "I only came up to look.",
          "goto": "society.clerk.gold.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": []
    },
    "proving.brief": {
      "name": "The proving floor",
      "cam": "none",
      "lines": [
        {
          "who": "narrator",
          "text": "A walled floor, half laid in flagstone and half left as bare earth. The door behind you is not a door any more."
        },
        {
          "who": "narrator",
          "text": "Something in the far corner is already getting up. It comes apart where the knife goes in, and it puts itself back together anywhere its feet find soil."
        },
        {
          "who": "narrator",
          "text": "Keep it on the stone."
        }
      ],
      "choices": [],
      "next": null,
      "sets": []
    },
    "society.greeter.essences.what": {
      "name": "Vail — what an essence is",
      "cam": "close",
      "lines": [
        {
          "who": "greeter",
          "text": "A stone about the size of a plum, and it stops being a stone the moment you swallow it. After that it is part of how you are put together."
        },
        {
          "who": "greeter",
          "text": "Fire does not make you good at fire. It makes fire one of the things you are made of, and then your body works out what to do about that."
        },
        {
          "who": "greeter",
          "text": "One ability from each to begin. The rest come later, out of stones the Society does not hand out and does not ask where you got."
        }
      ],
