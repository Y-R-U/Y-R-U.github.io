    "society.greeter.essences.confluence": {
      "name": "Vail — the confluence",
      "cam": "two",
      "lines": [
        {
          "who": "greeter",
          "text": "Confluence. Three essences sit together long enough and they agree on something none of them said."
        },
        {
          "who": "greeter",
          "text": "Some threes the registry knows by name. Some it does not, and then you write it up yourself and the Chapter files it under your name whether you wanted that or not."
        },
        {
          "who": "greeter",
          "text": "It cannot be traded, refused or swapped. This is the one door in the building that only opens the once."
        }
      ],
      "choices": [
        {
          "say": "What is an essence, exactly?",
          "goto": "society.greeter.essences.what",
          "sets": [],
          "if": [
            "not",
            [
              "flag",
              "society.knows.essences"
            ]
          ]
        },
        {
          "say": "Then let me choose carefully.",
          "goto": "society.greeter.essences.pick",
          "sets": []
        },
        {
          "say": "That is a lot to sign for.",
          "goto": "society.greeter.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": [
        {
          "k": "flag",
          "name": "society.knows.confluence",
          "value": true
        }
      ]
    },
    "society.greeter.abilities": {
      "name": "Vail — how to cast",
      "cam": "close",
      "lines": [
        {
          "who": "greeter",
          "text": "Reach for it the way you reach for a pocket. It is in there now; it does not need words."
        },
        {
          "who": "greeter",
          "text": "Right hand on the world opens what you can do with it — talk, trade, or cast. One to four if your hands are quicker than the menu, which in a fight they had better be."
        },
        {
          "who": "greeter",
          "text": "Four of them, and each one comes out looking like whatever it is made of. You will know which is which the first time you throw one."
        }
      ],
      "choices": [
        {
          "say": "What does it cost?",
          "goto": "society.greeter.abilities.cost",
          "sets": []
        },
        {
          "say": "And how does the Society count what I do?",
          "goto": "society.greeter.stars",
          "sets": [],
          "if": [
            "not",
            [
              "flag",
              "society.knows.stars"
            ]
          ]
        },
        {
          "say": "Understood.",
          "goto": "society.greeter.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": [
        {
          "k": "flag",
          "name": "society.knows.casting",
          "value": true
        }
      ]
    },
    "society.greeter.abilities.cost": {
      "name": "Vail — what it costs",
      "cam": "two",
      "lines": [
        {
          "who": "greeter",
          "text": "Mana. You have a shallow well of it and it fills back up on its own, slower than you will want."
        },
        {
          "who": "greeter",
          "text": "Iron adventurers die with a full well more often than an empty one. Spend it."
        }
      ],
      "choices": [
        {
          "say": "Right.",
          "goto": "society.greeter.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": []
    },
    "society.quartermaster.lesson": {
      "name": "Brann — the wrong lesson",
      "cam": "close",
      "lines": [
        {
          "who": "quartermaster",
          "text": "That the tool did it. Give a man a good blade for his first fight and he spends nine years thinking he won that one."
        },
        {
          "who": "quartermaster",
          "text": "This one is honest. If the thing falls over, that was you."
        }
      ],
      "choices": [
        {
          "say": "Any advice?",
          "goto": "society.quartermaster.advice",
          "sets": [],
          "if": [
            "not",
            [
              "flag",
              "society.knows.brann.advice"
            ]
          ]
        },
        {
          "say": "Fair enough.",
          "goto": "society.quartermaster.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": [
        {
          "k": "flag",
          "name": "society.knows.brann.lesson",
          "value": true
        }
      ]
    },
    "society.quartermaster.back": {
      "name": "Brann — the knife back",
      "cam": "two",
      "lines": [
        {
          "who": "quartermaster",
          "text": "Knife."
        },
        {
          "who": "player",
          "text": "It is a bit blunter than it was."
        },
        {
          "who": "quartermaster",
          "text": "It was blunt when I gave it to you. You have chipped it, which is different, and which I am writing down."
        },
        {
          "who": "quartermaster",
          "text": "Go on. Vail wants you at the desk before she loses the paperwork on purpose."
        }
      ],
      "choices": [
        {
          "say": "What do adventurers actually carry?",
          "goto": "society.quartermaster.kit",
          "sets": []
        },
        {
          "say": "Thank you, Brann.",
          "goto": "society.quartermaster.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": []
    },
    "society.quartermaster.kit": {
      "name": "Brann — what to carry",
      "cam": "two",
      "lines": [
        {
          "who": "quartermaster",
          "text": "Rope. Twice as much rope as you think. Then a lamp, then something to eat that is not going to go off in a bag."
        },
        {
          "who": "quartermaster",
          "text": "Everybody buys a sword. Nobody buys rope. Then a contract goes down a hole and I get a form to fill in."
        }
      ],
      "choices": [
        {
          "say": "Rope. Noted.",
          "goto": "society.quartermaster.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": []
    },
    "society.doorward.pass": {
      "name": "Bel — on the roll",
      "cam": "two",
      "lines": [
        {
          "who": "doorward",
          "text": "There she is. On the roll, iron rank, and no longer my problem."
        },
        {
          "who": "doorward",
          "text": "Second floor. Take the stair slowly the first time — it is taller than it looks from down here and it does the walking for you."
        }
      ],
      "choices": [
        {
          "say": "Do you ever go up?",
          "goto": "society.doorward.up",
          "sets": []
        },
        {
          "say": "Thanks, Bel.",
          "goto": "society.doorward.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": []
    },
    "society.doorward.up": {
      "name": "Bel — does he go up",
      "cam": "close",
      "lines": [
        {
          "who": "doorward",
          "text": "Silver, when I was worth something. Then a contract in the Hollows went the way those go."
        },
        {
          "who": "doorward",
          "text": "Now I stand at the bottom of a staircase and tell people what they are. It is warm and nobody bleeds on me."
        },
        {
          "who": "player",
          "text": "That does not sound like nothing."
        },
        {
          "who": "doorward",
          "text": "No. It does not, does it."
        }
      ],
      "choices": [
        {
          "say": "I will come back down and tell you how it went.",
          "goto": "society.doorward.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": []
    },
    "society.doorward.done": {
      "name": "Bel — parting",
      "cam": "none",
      "lines": [
        {
          "who": "doorward",
          "text": "Up you go. Boards do not read themselves, more is the pity."
        }
      ],
      "choices": [],
      "next": null,
      "sets": []
    },
    "society.clerk.iron.pick": {
      "name": "Ostrey — which one",
      "cam": "close",
      "lines": [
        {
          "who": "clerk_iron",
          "text": "The one you can walk to before dark. Not the one that pays."
        },
        {
          "who": "clerk_iron",
          "text": "Everybody takes the one that pays. I have a drawer of sheets from people who took the one that pays."
        }
      ],
      "choices": [
        {
          "say": "What kills iron adventurers?",
          "goto": "society.clerk.iron.road",
          "sets": [],
          "if": [
            "not",
            [
              "flag",
              "society.knows.ostrey.road"
            ]
          ]
        },
        {
          "say": "Before dark. Right.",
          "goto": "society.clerk.iron.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": [
        {
          "k": "flag",
          "name": "society.knows.ostrey.pick",
          "value": true
        }
      ]
    },
    "society.clerk.iron.road": {
      "name": "Ostrey — the road",
      "cam": "two",
      "lines": [
        {
          "who": "clerk_iron",
          "text": "The road. Not the work — the road. Four hours out, four hours back, and the thing you were sent for takes ten minutes."
        },
        {
          "who": "clerk_iron",
          "text": "It is tired that gets you. Take water. Take a second pair of socks. I am entirely serious about the socks."
        }
      ],
      "choices": [
        {
          "say": "Which one should I take?",
          "goto": "society.clerk.iron.pick",
          "sets": [],
          "if": [
            "not",
            [
              "flag",
              "society.knows.ostrey.pick"
            ]
          ]
        },
        {
          "say": "Socks. Noted.",
          "goto": "society.clerk.iron.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": [
        {
          "k": "flag",
          "name": "society.knows.ostrey.road",
          "value": true
        }
      ]
    },
    "society.clerk.iron.done": {
      "name": "Ostrey — parting",
      "cam": "none",
      "lines": [
        {
          "who": "clerk_iron",
          "text": "Good. Come back and tell me it was boring. Boring is my favourite word."
        }
      ],
      "choices": [],
      "next": null,
      "sets": []
    },
    "society.clerk.bronze.money": {
      "name": "Malle — who pays",
      "cam": "close",
      "lines": [
        {
          "who": "clerk_bronze",
          "text": "Iron, the Society covers your healer and your funeral. It is cheap for them and it keeps the intake up."
        },
        {
          "who": "clerk_bronze",
          "text": "Bronze, you carry it. Read the fee, then read what it would cost you to be wrong, and take the difference seriously."
        }
      ],
      "choices": [
        {
          "say": "You do not sound impressed.",
          "goto": "society.clerk.bronze.dry",
          "sets": []
        },
        {
          "say": "Understood.",
          "goto": "society.clerk.bronze.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": [
        {
          "k": "flag",
          "name": "society.knows.malle.money",
          "value": true
        }
      ]
    },
    "society.clerk.bronze.dry": {
      "name": "Malle — nine years of this",
      "cam": "two",
      "lines": [
        {
          "who": "clerk_bronze",
          "text": "Nine years on this floor. I have stamped the sheet of everybody who ever got to silver out of this chapter."
        },
        {
          "who": "clerk_bronze",
          "text": "Eleven of them. I could tell you all their names. I would rather tell you about the socks, honestly, but Ostrey has that one."
        }
      ],
      "choices": [
        {
          "say": "Eleven.",
          "goto": "society.clerk.bronze.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": []
    },
    "society.clerk.bronze.done": {
      "name": "Malle — parting",
      "cam": "none",
      "lines": [
        {
          "who": "clerk_bronze",
          "text": "Go on. And sign it yourself — I am not forging another one."
        }
      ],
      "choices": [],
      "next": null,
      "sets": []
    },
    "society.clerk.silver.read": {
      "name": "Vane — read it twice",
      "cam": "close",
      "lines": [
        {
          "who": "clerk_silver",
          "text": "Twice. Once for what it says and once for what it does not."
        },
        {
          "who": "clerk_silver",
          "text": "The clients are not lying to you. They are telling you the part they understand, and the part they do not understand is the part that is going to be waiting for you."
        },
        {
          "who": "clerk_silver",
          "text": "When a sheet is short, ask why it is short."
        }
      ],
      "choices": [
        {
          "say": "You have been up here a long time.",
          "goto": "society.clerk.silver.long",
          "sets": []
        },
        {
          "say": "Twice. All right.",
          "goto": "society.clerk.silver.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": [
        {
          "k": "flag",
          "name": "society.knows.vane.read",
          "value": true
        }
      ]
    },
    "society.clerk.silver.long": {
      "name": "Vane — a long time",
      "cam": "two",
      "lines": [
        {
          "who": "clerk_silver",
          "text": "I keep the sheets of the ones that came back as well. People only ever ask about the others."
        },
        {
          "who": "player",
          "text": "How many is that?"
        },
        {
          "who": "clerk_silver",
          "text": "More. It is always more. Nobody believes me and I stopped minding about a decade ago."
        }
      ],
      "choices": [
        {
          "say": "Thank you.",
          "goto": "society.clerk.silver.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": []
    },
    "society.clerk.silver.done": {
      "name": "Vane — parting",
      "cam": "none",
      "lines": [
        {
          "who": "clerk_silver",
          "text": "Take your time on the stair. Nobody up here is in a hurry any more."
        }
      ],
      "choices": [],
      "next": null,
      "sets": []
    },
    "society.clerk.gold.three": {
      "name": "Ashenrow — why three",
      "cam": "close",
      "lines": [
        {
          "who": "clerk_gold",
          "text": "Two have been on that board for a year and the province has arranged itself around them. Roads moved. A village moved."
        },
        {
          "who": "clerk_gold",
          "text": "The third went up in the spring. I would rather it had not."
        }
      ],
      "choices": [
        {
          "say": "Do you have to say that to everyone?",
          "goto": "society.clerk.gold.obliged",
          "sets": []
        },
        {
          "say": "I see.",
          "goto": "society.clerk.gold.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": []
    },
    "society.clerk.gold.obliged": {
      "name": "Ashenrow — obliged",
      "cam": "two",
      "lines": [
        {
          "who": "clerk_gold",
          "text": "To everyone who reaches this floor, yes. It is nine words in the charter and I have said them four times in eleven years."
        },
        {
          "who": "clerk_gold",
          "text": "Twice to the same man. He is the reason it is nine words and not four."
        }
      ],
      "choices": [
        {
          "say": "Four times.",
          "goto": "society.clerk.gold.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": []
    },
    "society.clerk.gold.done": {
      "name": "Ashenrow — parting",
      "cam": "none",
      "lines": [
        {
          "who": "clerk_gold",
          "text": "The stair is behind you. Nothing up here is going anywhere."
        }
      ],
      "choices": [],
      "next": null,
      "sets": []
    },
    "society.greeter.stars": {
      "name": "Vail — stars",
      "cam": "two",
      "lines": [
        {
          "who": "greeter",
          "text": "Stars. Four to a rank. You get them for closing contracts, and a contract that nearly killed you counts for more than one that did not."
        },
        {
          "who": "greeter",
          "text": "Four stars at iron and the Society will hear an application for bronze. It is not automatic. Somebody reads the file."
        },
        {
          "who": "player",
          "text": "Who reads it?"
        },
        {
          "who": "greeter",
          "text": "I do. So bring the sheets back, and write on them like a person and not like somebody hiding something."
        }
      ],
      "choices": [
        {
          "say": "Where do I see them?",
          "goto": "society.greeter.stars.where",
          "sets": []
        },
        {
          "say": "Understood.",
          "goto": "society.greeter.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": [
        {
          "k": "flag",
          "name": "society.knows.stars",
          "value": true
        }
      ]
    },
    "society.greeter.stars.where": {
      "name": "Vail — the record",
      "cam": "close",
      "lines": [
        {
          "who": "greeter",
          "text": "You carry a copy. Everyone does — rank, stars, what you took and what it gave you."
        },
        {
          "who": "greeter",
          "text": "The Society keeps the other one, and ours has more in it than yours does. That is not a threat, it is a filing system."
        }
      ],
      "choices": [
        {
          "say": "Fair enough.",
          "goto": "society.greeter.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": []
    },
    "society.clerk.iron.stars": {
      "name": "Ostrey — getting to bronze",
      "cam": "two",
      "lines": [
        {
          "who": "clerk_iron",
          "text": "Four stars, and then Vail decides. Every sheet you bring back is a line on the file."
        },
        {
          "who": "clerk_iron",
          "text": "The ones that go wrong are lines too, mind. Better lines, sometimes. A person who came back and wrote down exactly how it went is worth two who came back and said it was fine."
        }
      ],
      "choices": [
        {
          "say": "Which one should I take?",
          "goto": "society.clerk.iron.pick",
          "sets": [],
          "if": [
            "not",
            [
              "flag",
              "society.knows.ostrey.pick"
            ]
          ]
        },
        {
          "say": "Noted.",
          "goto": "society.clerk.iron.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": [
        {
          "k": "flag",
          "name": "society.knows.ostrey.stars",
          "value": true
        }
      ]
    },
    "society.greeter.promote": {
      "name": "Vail — promotion",
      "cam": "two",
      "lines": [
        {
          "who": "greeter",
          "text": "Four stars. I have read the file, which is more than the Chapter does, and the file says you come back and you write it down."
        },
        {
          "who": "greeter",
          "text": "So. Hold still."
        },
        {
          "who": "narrator",
          "text": "She takes the seal out of the drawer, breathes on it, and presses it into the wax at the bottom of your sheet without any ceremony whatsoever."
        }
      ],
      "choices": [
        {
          "say": "That is it?",
          "goto": "society.greeter.promote.that",
          "sets": []
        },
        {
          "say": "Thank you.",
          "goto": "society.greeter.promote.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": []
    },
    "society.greeter.promote.that": {
      "name": "Vail — that is it",
      "cam": "close",
      "lines": [
        {
          "who": "greeter",
          "text": "There is a ceremony. It is in the spring and it is four hours long and half the people in it are dead by the following one."
        },
        {
          "who": "greeter",
          "text": "This is the part that matters. The stair will let you up, and the floor above will let you take work that can kill you at your own expense."
        }
      ],
      "choices": [
        {
          "say": "Understood.",
          "goto": "society.greeter.promote.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": []
    },
    "society.greeter.promote.done": {
      "name": "Vail — promoted",
      "cam": "none",
      "lines": [
        {
          "who": "greeter",
          "text": "Go up. Read twice. Come back down and tell me it was boring."
        }
      ],
      "choices": [],
      "next": null,
      "sets": [
        {
          "k": "promote"
        }
      ]
    }
  }
}
