    "society.stair.refuse.iron": {
      "name": "Stair — refused, iron",
      "cam": "close",
      "lines": [
        {
          "who": "doorward",
          "text": "Hold it. Iron rank up those stairs, and you are not on the roll yet."
        },
        {
          "who": "doorward",
          "text": "Vail is at the desk behind you. Get signed, get proved, come back, and I will not say a word."
        }
      ],
      "choices": [],
      "next": null,
      "sets": []
    },
    "society.stair.refuse.bronze": {
      "name": "Stair — refused, bronze",
      "cam": "close",
      "lines": [
        {
          "who": "clerk_iron",
          "text": "Not that floor. Bronze above us, and you are iron."
        },
        {
          "who": "clerk_iron",
          "text": "Close a few off this board and the stair will let you by. It is not personal. It is a ledger."
        }
      ],
      "choices": [],
      "next": null,
      "sets": []
    },
    "society.stair.refuse.silver": {
      "name": "Stair — refused, silver",
      "cam": "close",
      "lines": [
        {
          "who": "clerk_bronze",
          "text": "Silver, that. Bronze is as far as you go today."
        },
        {
          "who": "clerk_bronze",
          "text": "The Society counts what you finish, not what you attempt. So finish more, and do try to be dull about it."
        }
      ],
      "choices": [],
      "next": null,
      "sets": []
    },
    "society.stair.refuse.gold": {
      "name": "Stair — refused, gold",
      "cam": "close",
      "lines": [
        {
          "who": "clerk_silver",
          "text": "Gold floor. I am going to have to ask you to come back down."
        },
        {
          "who": "clerk_silver",
          "text": "There are three contracts up there. The Chapter reads out the name of everyone who goes up to look at them, and I have heard that list read at funerals."
        }
      ],
      "choices": [],
      "next": null,
      "sets": []
    },
