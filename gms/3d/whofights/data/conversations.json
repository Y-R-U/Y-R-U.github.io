    "society.greeter.hello": {
      "name": "Vail — first hello",
      "cam": "two",
      "lines": [
        {
          "who": "narrator",
          "text": "The hall swallows the sound of your boots. Somebody has been waiting for you.",
          "vo": "narrator_hall_01"
        },
        {
          "who": "greeter",
          "text": "A dark robe, walking into the Adventure Society off the square. Nobody minds the colour so long as you can hold a line."
        },
        {
          "who": "greeter",
          "text": "Contracts are on the boards behind me. Iron first — everyone starts on iron.",
          "vo": "greeter_hello_02"
        }
      ],
      "choices": [
        {
          "say": "Who are you?",
          "goto": "society.greeter.who",
          "sets": []
        },
        {
          "say": "What is a contract?",
          "goto": "society.greeter.contracts",
          "sets": []
        },
        {
          "say": "How do I join?",
          "goto": "society.greeter.test",
          "sets": []
        },
        {
          "say": "I'll read them myself.",
          "goto": "society.greeter.brushoff",
          "sets": [
            {
              "k": "flag",
              "name": "society.brushed.vail",
              "value": true
            }
          ]
        }
      ],
      "next": null,
      "sets": [
        {
          "k": "flag",
          "name": "society.met.registrar",
          "value": true
        }
      ]
    },
