    "society.quartermaster.advice": {
      "name": "Brann — advice",
      "cam": "two",
      "lines": [
        {
          "who": "quartermaster",
          "text": "Elementals of that sort do not chase well and do not think at all. Stand on the stone. Make it come to you across the stone."
        },
        {
          "who": "quartermaster",
          "text": "If it gets a foot in the dirt it starts putting itself back together faster than you are taking it apart. Then you have a long afternoon."
        }
      ],
      "choices": [
        {
          "say": "What is the wrong lesson?",
          "goto": "society.quartermaster.lesson",
          "sets": [],
          "if": [
            "not",
            [
              "flag",
              "society.knows.brann.lesson"
            ]
          ]
        },
        {
          "say": "Stone. Understood.",
          "goto": "society.quartermaster.done",
          "sets": []
        }
      ],
      "next": null,
      "sets": [
        {
          "k": "flag",
          "name": "society.knows.brann.advice",
          "value": true
        }
      ]
    },
