[Unit]
Description=gambit — GAMBIT online chess lobby, relay, clocks and ratings (games.br8t.com/gms/3d/gambit/)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/apps/gambit
ExecStart=/srv/apps/gambit/gambit
Restart=on-failure
RestartSec=3
Environment=GAMBIT_ADDR=127.0.0.1:8019
Environment=GAMBIT_DATA=/srv/data/gambit
Environment=GAMBIT_PREFIX=/gms/3d/gambit
# Signed-in allowance through br8t-payments on loopback (needs chess=5 in its BR8T_FREE_PER_DAY).
Environment=GAMBIT_ALLOWANCE=on
Environment=GAMBIT_ALLOWANCE_URL=http://127.0.0.1:8016/api/br8t/
Environment=GAMBIT_ALLOWANCE_GAME=chess
Environment=GOMEMLIMIT=40MiB
MemoryMax=96M
# Optional overrides (origins, limits) live only on the box; "-" = optional. NEVER set GAMBIT_DEV_AUTH here.
EnvironmentFile=-/srv/data/gambit/gambit.env
UMask=0077
TimeoutStopSec=8

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/data/gambit

[Install]
WantedBy=multi-user.target
